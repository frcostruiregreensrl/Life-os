# Copia questo file in ".env" e riempi i valori.
# ".env" non va mai committato (è già in .gitignore).

# Obbligatoria solo per l'assistente di onboarding (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Facoltativa: modello usato per la conversazione di onboarding
# ANTHROPIC_ONBOARDING_MODEL=claude-sonnet-5

# Obbligatoria in produzione, facoltativa in locale (stringa a caso va bene)
SESSION_SECRET=cambia-questa-stringa-in-locale

# Facoltative, hanno già un default sensato
# PORT=5000
# DATABASE_URL=./data.db
